# Copy to .env for local rehearsal (never commit .env)

# Lightwell Console → service account (format: <orgId>|<service-account-name>)
LIGHTWELL_PYPI_USER='11009103|dasmlwsvc'
LIGHTWELL_TOKEN_FILE=/home/dasm/dasmlwsvc.token

# --- Four Console repos; this kit uses the two Python feeds ---
# Python Remediated (patched +rhlw.N)
LIGHTWELL_REMEDIATED_SIMPLE=https://packages.redhat.com/lightwell/python/remediated/simple
LIGHTWELL_REMEDIATED_REMOTE=https://packages.redhat.com/api/pulp-content/lightwell/python/remediated/

# Python Validated (broad RH-built catalog)
LIGHTWELL_VALIDATED_SIMPLE=https://packages.redhat.com/lightwell/python/validated/simple
LIGHTWELL_VALIDATED_REMOTE=https://packages.redhat.com/api/pulp-content/lightwell/python/validated/

# Back-compat
LIGHTWELL_PYPI_URL=https://packages.redhat.com/lightwell/python/remediated/simple

# Artifactory virtual (after bootstrap) — preferred live Poetry index
# PYPI_INDEX_URL=http://localhost:8082/artifactory/api/pypi/pypi-virtual/simple
USE_LIGHTWELL=true

LIGHTWELL_LENS_URL=

ARTIFACTORY_URL=http://localhost:8082/artifactory
ARTIFACTORY_USER=admin
ARTIFACTORY_PASSWORD=password

NEXUS_URL=http://localhost:8081
