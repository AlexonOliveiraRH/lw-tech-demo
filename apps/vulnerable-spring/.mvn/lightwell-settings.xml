<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for the Lightwell Java feeds. No secrets in this file:
  Maven reads the service account from the environment at build time.

    export LIGHTWELL_USER='orgId|service-account-name'
    export LIGHTWELL_TOKEN='<service account token>'
    mvn -s .mvn/lightwell-settings.xml -P lightwell verify
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>lightwell-remediated</id>
      <username>${env.LIGHTWELL_USER}</username>
      <password>${env.LIGHTWELL_TOKEN}</password>
    </server>
    <server>
      <id>lightwell-validated</id>
      <username>${env.LIGHTWELL_USER}</username>
      <password>${env.LIGHTWELL_TOKEN}</password>
    </server>
  </servers>
</settings>
