# Lightwell Console → Pipenv tab
# ~/.netrc:
#   machine packages.redhat.com login 11009103|dasmlwsvc password <token>
# Install:
#   pipenv install --index https://packages.redhat.com/lightwell/python/remediated/simple

[[source]]
url = "https://packages.redhat.com/lightwell/python/remediated/simple"
verify_ssl = true
name = "lightwell"

# Prefer Artifactory virtual once wired:
# url = "http://localhost:8082/artifactory/api/pypi/pypi-virtual/simple"
# name = "artifactory-lightwell"

[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
uvicorn = {extras = ["standard"], version = "*"}
httpx = "*"
sqlparse = {version = "==0.5.5", index = "lightwell"}

[dev-packages]
pytest = "*"

[requires]
python_version = "3.12"
